<% layout('layouts/boilerplate') %>

<div class="row mt-4">
    <div class="col-8 offset-2">

        <h3 class="card-title"><%= listing.title %></h3>

        <div class="card mb-4">
            <img 
                src="<%= listing.image.url %>" 
                class="card-img-top show-img" 
                alt="Listing Image"
            >

            <div class="card-body">
                <p class="card-text"><%= listing.description %></p>

                <p class="card-text">
                    <strong>Price:</strong>
                    ₹ <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> / night
                </p>

                <p class="card-text">
                    <strong>Location:</strong>
                    <%= listing.location %>, <%= listing.country %>
                </p>
            </div>
        </div>

        <div class="d-flex gap-3">
            <a 
                href="/listings/<%= listing._id %>/edit" 
                class="btn btnclr"
            >
                Edit
            </a>

            <form 
                method="POST" 
                action="/listings/<%= listing._id %>?_method=DELETE"
            >
                <button class="btn btn-danger">
                    Delete
                </button>
            </form>
        </div>
        <div class="col-8 offset-2 mb-3" ></div>
        <br>
        <hr>
        <div>Leave a Review</div>
        <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">
            <div>
                <label for="ratings" class="form-label">Ratings</label>
                <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range" >
            </div>
            <div>
                <label for="comments">Comments</label>
                <textarea name="review[comment]" id="comment" cols="30" rows="10" class="form-control"></textarea>
            </div>
            <br>
            <button class="btnclr">Submit</button>
        </form>

        <br>
    </div>
</div>
